{
  "name": "pixel-perfect-replica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:netlify": "vite build --mode production && echo '=== BUILD COMPLETED ===' && find . -type d \\( -name 'dist' -o -name '.output' -o -name '.nitro' \\) | head -10 && ls -la dist/ 2>/dev/null || echo 'No dist folder' && ls -la .output/ 2>/dev/null || echo 'No .output folder'",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@lovable.dev/vite-tanstack-config": "latest",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "nitro": "^3.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}